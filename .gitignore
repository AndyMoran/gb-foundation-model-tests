# Weather forecast files are kept locally, not in the repository; manifest.csv records their hashes
prospective/weather/data/
prospective/weather/collect.log
*.grib2
*.nc
__pycache__/
# Model weights are never committed
*.safetensors

# Downloaded inputs stay local until we decide whether to publish them; data/fetch_manifest.json records their hashes
data/*
!data/fetch_manifest.json

# Prospective forecast log stays local; each day's record is in prospective/forecasts/days/
prospective/forecasts/forecast.log
